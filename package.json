{
  "name": "channel-rpc",
  "version": "0.4.0",
  "description": "JSON-RPC over postMessage",
  "author": "kouhin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouhin/channel-rpc.git"
  },
  "homepage": "https://github.com/kouhin/channel-rpc#readme",
  "bugs": {
    "url": "https://github.com/kouhin/channel-rpc/issues"
  },
  "packageManager": "bun@1.4.2",
  "type": "module",
  "source": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "bun test ./test/unit",
    "build": "bun run scripts/build.ts",
    "test:browser": "playwright test",
    "check:package": "bun run scripts/check-package.ts",
    "release:check": "bun run scripts/check-release.ts",
    "verify": "bun run check && bun run typecheck && bun run test && bun run build && bun run test:browser && bun run check:package",
    "prepack": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "channel",
    "messaging",
    "iframe",
    "rpc",
    "json-rpc"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "acorn": "8.18.0",
    "npm": "12.0.2",
    "publint": "0.3.24",
    "typescript": "7.0.2"
  }
}
